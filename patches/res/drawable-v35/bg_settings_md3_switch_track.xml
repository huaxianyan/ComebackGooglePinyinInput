<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <size android:width="52dp" android:height="32dp" />
            <solid android:color="@color/settings_md3_surface_container" />
            <stroke android:width="2dp" android:color="@color/settings_md3_outline_variant" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <size android:width="52dp" android:height="32dp" />
            <solid android:color="@color/settings_md3_primary" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <size android:width="52dp" android:height="32dp" />
            <solid android:color="@color/settings_md3_surface_container_high" />
            <stroke android:width="2dp" android:color="@color/settings_md3_outline" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
