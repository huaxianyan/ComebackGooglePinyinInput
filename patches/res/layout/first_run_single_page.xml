<?xml version="1.0" encoding="utf-8"?>
<com.google.android.apps.inputmethod.pinyin.firstrun.FirstRunSinglePage
    xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/FirstRunPage"
    layoutResId="@layout/first_run_single_page">

    <ScrollView
        android:fillViewport="true"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingLeft="24dp"
            android:paddingTop="40dp"
            android:paddingRight="24dp"
            android:paddingBottom="32dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:src="@drawable/ic_first_run_page_app_logo_alia"
                android:scaleType="centerInside"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:layout_width="72dp"
                android:layout_height="72dp" />

            <TextView
                android:id="@id/first_run_page_setup_step_title"
                android:text="@string/first_run_single_page_title"
                style="@style/FirstRunSinglePageTitle" />

            <TextView
                android:text="@string/first_run_single_page_description"
                style="@style/FirstRunSinglePageDescription" />

            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/bg_first_run_md3_step_card"
                android:padding="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp">

                <LinearLayout
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:text="1"
                        android:contentDescription="@string/first_run_single_enable_step"
                        style="@style/FirstRunSinglePageStepNumber" />
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginLeft="16dp">
                        <TextView
                            android:text="@string/first_run_single_enable_title"
                            style="@style/FirstRunSinglePageStepTitle" />
                        <TextView
                            android:text="@string/first_run_single_enable_summary"
                            style="@style/FirstRunSinglePageStepSummary" />
                    </LinearLayout>
                </LinearLayout>

                <Button
                    android:id="@+id/first_run_single_enable_action"
                    android:text="@string/first_run_enable_hint"
                    style="@style/FirstRunSinglePageStepButton" />
                <LinearLayout
                    android:id="@+id/first_run_single_enable_done"
                    android:visibility="gone"
                    style="@style/FirstRunSinglePageDone">
                    <ImageView style="@style/FirstRunPageSettingsDoneCheck" />
                    <TextView style="@style/FirstRunPageSettingsDoneText" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/bg_first_run_md3_step_card"
                android:padding="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:text="2"
                        android:contentDescription="@string/first_run_single_select_step"
                        style="@style/FirstRunSinglePageStepNumber" />
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginLeft="16dp">
                        <TextView
                            android:text="@string/first_run_single_select_title"
                            style="@style/FirstRunSinglePageStepTitle" />
                        <TextView
                            android:text="@string/first_run_single_select_summary"
                            style="@style/FirstRunSinglePageStepSummary" />
                    </LinearLayout>
                </LinearLayout>

                <Button
                    android:id="@+id/first_run_single_select_action"
                    android:text="@string/first_run_select_input_method_hint"
                    style="@style/FirstRunSinglePageStepButton" />
                <LinearLayout
                    android:id="@+id/first_run_single_select_done"
                    android:visibility="gone"
                    style="@style/FirstRunSinglePageDone">
                    <ImageView style="@style/FirstRunPageSettingsDoneCheck" />
                    <TextView style="@style/FirstRunPageSettingsDoneText" />
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/first_run_single_finish"
                android:enabled="false"
                android:text="@string/first_run_single_finish"
                style="@style/FirstRunSinglePageFinishButton" />
        </LinearLayout>
    </ScrollView>
</com.google.android.apps.inputmethod.pinyin.firstrun.FirstRunSinglePage>
