<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Match Compose Material 3 dynamicDarkColorScheme() to the nearest
         public system tonal-palette roles available to legacy Views. -->
    <color name="first_run_md3_primary">@android:color/system_accent1_200</color>
    <color name="first_run_md3_on_primary">@android:color/system_accent1_800</color>
    <color name="first_run_md3_primary_container">@android:color/system_accent1_700</color>
    <color name="first_run_md3_on_primary_container">@android:color/system_accent1_100</color>
    <color name="first_run_md3_surface">@android:color/system_neutral2_900</color>
    <color name="first_run_md3_surface_container">@android:color/system_neutral2_800</color>
    <color name="first_run_md3_on_surface">@android:color/system_neutral2_100</color>
    <color name="first_run_md3_on_surface_variant">@android:color/system_neutral2_200</color>
    <color name="first_run_md3_outline">@android:color/system_neutral2_400</color>

    <style name="AppThemeSelector.NoTitle" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/first_run_md3_surface</item>
        <item name="android:navigationBarColor">@color/first_run_md3_surface</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
